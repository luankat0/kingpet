generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String @id @default(uuid()) @db.Uuid
  email     String @unique
  senhaHash String @map("senha_hash")

  tutor Tutor?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

model Tutor {
  id       String  @id @default(uuid()) @db.Uuid
  nome     String
  telefone String
  endereco String?

  usuarioId String  @unique @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  pets Pet[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("tutores")
}

enum Especie {
  CACHORRO
  GATO
  AVE
  ROEDOR
  OUTRO

  @@map("especie")
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE

  @@map("porte")
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO

  @@map("status_agendamento")
}

model Pet {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String
  especie         Especie
  raca            String?
  porte           Porte?
  dataNascimento  DateTime? @map("data_nascimento") @db.Date
  observacoes     String?

  tutorId String @map("tutor_id") @db.Uuid
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  agendamentos Agendamento[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([tutorId])
  @@map("pets")
}

model Servico {
  id             String  @id @default(uuid()) @db.Uuid
  nome           String  @unique
  descricao      String?
  preco          Decimal @db.Decimal(10, 2)
  duracaoMinutos Int     @map("duracao_minutos")
  ativo          Boolean @default(true)

  agendamentos Agendamento[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("servicos")
}

model Agendamento {
  id          String            @id @default(uuid()) @db.Uuid
  dataHora    DateTime          @map("data_hora")
  status      StatusAgendamento @default(AGENDADO)
  observacoes String?

  petId String @map("pet_id") @db.Uuid
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  servicoId String  @map("servico_id") @db.Uuid
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([petId])
  @@index([servicoId])
  @@index([dataHora])
  @@map("agendamentos")
}
